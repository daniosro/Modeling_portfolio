title: "Process-Based Modeling in Ocean and Climate Science"
author: "Daniela Osorio Rodriguez, PhD"
logo: ""

# Build settings
only_build_toc_files: true

# HTML settings
html:
  use_issues_button: false
  use_repository_button: true
  use_edit_page_button: false
  home_page_in_navbar: true
  navbar_number_sections: false
  google_analytics_id: ""
  extra_navbar: ""
  extra_footer: |
    <p>Daniela Osorio Rodriguez, PhD | University of Southern California</p>

# LaTeX settings
latex:
  latex_engine: pdflatex

# Launch button settings
launch_buttons:
  notebook_interface: "jupyterlab"
  binderhub_url: ""
  colab_url: ""
  thebe: false

# Repository settings
repository:
  url: https://github.com/daniosro
  branch: main
  path_to_book: ""

# Execution settings
execute:
  execute_notebooks: "off"
  timeout: 300
  allow_errors: false

# Sphinx settings
sphinx:
  extra_extensions: []
  config:
    html_show_sourcelink: false
    bibtex_bibfiles: []
